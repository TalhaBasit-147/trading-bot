# ─────────── Runtime mode ───────────
# paper | live
MODE=live

# ─────────── Symbol ───────────
PRIMARY_SYMBOL=XAUUSD

# ─────────── Strategy ───────────
RR_TARGET=2.0
STARTING_EQUITY=1000
PREV_DAY_NO_ENTRY_AFTER_UTC_HOUR=11

# ─────────── Risk ───────────
RISK_PER_TRADE=0.02
MAX_DAILY_LOSS=0.06
MAX_WEEKLY_LOSS=0.10
MAX_TRADES_PER_DAY=1
MAX_CONCURRENT_TRADES=1
CONSEC_LOSS_COOLDOWN_HOURS=2

# ─────────── MT5 ───────────
MT5_LOGIN=YOUR_MT5_ACCOUNT_NUMBER
MT5_PASSWORD=YOUR_MT5_PASSWORD
MT5_SERVER=YOUR_BROKER_SERVER
MT5_PATH=
MT5_MAGIC=20251116

# ─────────── Database ───────────
DATABASE_URL=sqlite:///./smc.db

# ─────────── API ───────────
API_HOST=0.0.0.0
API_PORT=8080
API_TOKEN=change-me

# ─────────── Logging ───────────
LOG_LEVEL=INFO
LOG_DIR=./logs

# ─────────── News filter ───────────
NEWS_API_KEY=YOUR_NEWSAPI_KEY_FROM_FOREX-CALENDAR.PRO

# ─────────── Telegram ───────────
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID